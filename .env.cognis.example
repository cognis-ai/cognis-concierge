# =============================================================================
# .env.cognis.example — Cognis Concierge fork-layer environment reference
# =============================================================================
#
# Cognis-ONLY variables added by this fork (letta/branding/cognis_brand.py and
# letta/server/rest_api/middleware/cognis_auth.py). Upstream Letta variables
# stay documented in upstream's .env.example — that file is upstream-owned and
# intentionally NOT modified (theming spec b-2; fork-ops.md discipline).
#
# Every variable here is optional: with nothing set, the server boots with the
# Cognis Concierge defaults shown below and the Clerk auth gate stays a no-op
# (upstream-parity local dev).
#
# Copy what you need into your deploy env (compose `environment:`, Coolify app
# env, or a real .env). Never commit a real .env.
# =============================================================================

# --- Branding (letta/branding/cognis_brand.py) -------------------------------
# Single source of truth for customer-visible brand strings: OpenAPI /docs
# title + description, FastAPI summary, and the startup banner. A portfolio-
# wide rename is env-only — zero file edits (theming spec §0).

# Product name (startup banner, OpenAPI info)
#COGNIS_BRAND_NAME="Cognis Concierge"

# Short brand name for tight surfaces
#COGNIS_BRAND_SHORT_NAME="Cognis"

# One-line tagline (FastAPI `summary` at /docs). Keep in lockstep with
# cognis-platform/apps/portal/lib/products.ts (concierge entry).
#COGNIS_BRAND_TAGLINE="Cognis Concierge — remembers everything, always on."

# Long-form product description (OpenAPI `info.description`)
#COGNIS_BRAND_DESCRIPTION="Cognis Concierge is the personal-AI / stateful-memory product from Cognis AI. Build agents that remember everything across sessions, tools, and conversations."

# OpenAPI `info.title` shown at /docs
#COGNIS_BRAND_API_TITLE="Cognis Concierge API"

# Logo URL. Default resolves against this server: the fork mounts
# letta/branding/assets/ at /brand-assets (see app.py create_application).
#COGNIS_BRAND_LOGO_URL="/brand-assets/cognis-logo.svg"

# Customer docs site
#COGNIS_BRAND_DOCS_URL="https://cognisai.com"

# Support email
#COGNIS_BRAND_SUPPORT_EMAIL="hello@cognisai.com"

# Optional portal/dashboard pointer in the startup banner. UNSET by default:
# the banner then shows no dashboard line (and never advertises upstream's
# hosted product). Set to the Cognis portal in real deploys.
#COGNIS_BRAND_DASHBOARD_URL="https://ai.cognis.group"

# --- Auth (letta/server/rest_api/middleware/cognis_auth.py) ------------------
# Pattern B direct access: verifying Clerk JWTs (RS256 via JWKS) on /v1/*
# (health/ready stay public). NO-OP when JWT_PUBLIC_KEY_URL is unset — local
# dev keeps upstream parity. Production deploys MUST set it (repo CLAUDE.md,
# "Deployment env"); SEC-4 is closed only when this fork image runs with the
# auth gate active.

# Clerk JWKS endpoint, e.g. https://<clerk-frontend-api>/.well-known/jwks.json
#JWT_PUBLIC_KEY_URL=

# Optional issuer / audience pinning for the verified JWTs
#JWT_ISSUER=
#JWT_AUDIENCE=
